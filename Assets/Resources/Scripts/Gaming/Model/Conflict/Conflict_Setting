using UnityEngine;
using UnityEngine.SceneManagement;

public class Conflict_Setting : MonoBehaviour
{
    //======设置页面下的相关UI组件的引用======//
    public GameObject Pnl_Setting;//设置页面
    // Start is called before the first frame update
    void Start()
    {
        if(Pnl_Setting.activeSelf)
        {
            Pnl_Setting.SetActive(false);
        }

    }
    //======设置页面下的功能======//
    public void OpenSetting()
    {
        Pnl_Setting.SetActive(true);//打开设置
        Time.timeScale = 0;//暂停
    }
    public void CloseSetting()
    {
        Pnl_Setting.SetActive(false);//关闭设置页面
        Time.timeScale = 1;//恢复
    }
    //======重新加载游戏======//
    public void RestartGame()
    {
        //获取当前场景下的名称
        string currentScene = SceneManager.GetActiveScene().name;
        //调用加载场景管理器
        if (Loading_UIManager.Instance != null)
        {
            Debug.Log("加载场景管理器存在");
            Loading_UIManager.Instance.OnLoadScene(currentScene);
        }
        Time.timeScale = 1;//恢复
    }
}
