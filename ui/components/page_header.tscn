[sub_resource type="Shader" id="DiamondClip"]
code = "shader_type canvas_item;\nvoid fragment() { float edge = abs(UV.x - 0.5) + abs(UV.y - 0.5); COLOR.a *= 1.0 - smoothstep(0.48, 0.50, edge); }"

[sub_resource type="ShaderMaterial" id="Diamond"]
shader = SubResource("DiamondClip")

