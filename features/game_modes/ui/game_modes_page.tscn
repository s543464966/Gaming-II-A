[sub_resource type="Shader" id="diamond"]
code = "shader_type canvas_item;
uniform vec2 extent = vec2(108.0, 110.0);
varying vec2 local_uv;
void vertex() { local_uv = VERTEX / extent; }
void fragment() { float edge = abs(local_uv.x - 0.5) + abs(local_uv.y - 0.5); COLOR.a *= 1.0 - smoothstep(0.48, 0.50, edge); }"

[sub_resource type="ShaderMaterial" id="diamond_material"]
shader = SubResource("diamond")

[sub_resource type="Shader" id="icon_mask"]
code = "shader_type canvas_item;\nuniform bool dark_ink = true;\nvarying vec4 tint;\nvoid vertex() { tint = COLOR; }\nvoid fragment() { vec4 sample_color = texture(TEXTURE, UV); float luminance = dot(sample_color.rgb, vec3(0.299, 0.587, 0.114)); float coverage = dark_ink ? 1.0 - smoothstep(0.24, 0.53, luminance) : smoothstep(0.24, 0.57, luminance); COLOR = vec4(tint.rgb, tint.a * coverage); }"

[sub_resource type="ShaderMaterial" id="gold_icon"]
shader = SubResource("icon_mask")
shader_parameter/dark_ink = false

[sub_resource type="ShaderMaterial" id="ink_icon"]
shader = SubResource("icon_mask")
shader_parameter/dark_ink = true

[sub_resource type="AtlasTexture" id="selected_plaque"]
atlas = ExtResource("plaque")
region = Rect2(76, 100, 1299, 862)
filter_clip = true

[sub_resource type="Shader" id="plaque_clip"]
code = "shader_type canvas_item;\nvarying vec2 plaque_uv;\nvoid vertex() { plaque_uv = VERTEX / vec2(241.75, 187.0); }\nvoid fragment() {\n\t// 在原图尺寸中沿四个实际切角内缩，抗锯齿宽度随屏幕像素变化。\n\tvec2 p = plaque_uv * vec2(1299.0, 862.0);\n\tfloat edge = min(min(p.x, 1299.0 - p.x), min(p.y, 862.0 - p.y)) - 3.0;\n\tedge = min(edge, (p.x / 164.0 + p.y / 172.0 - 1.04) * 120.0);\n\tedge = min(edge, ((1299.0 - p.x) / 168.0 + p.y / 172.0 - 1.04) * 120.0);\n\tedge = min(edge, (p.x / 164.0 + (862.0 - p.y) / 184.0 - 1.04) * 120.0);\n\tedge = min(edge, ((1299.0 - p.x) / 168.0 + (862.0 - p.y) / 184.0 - 1.04) * 120.0);\n\t// 清除边缘采样混入的中性浅底，保留暖金色金属高光。\n\tfloat lowest = min(COLOR.r, min(COLOR.g, COLOR.b));\n\tfloat chroma = max(COLOR.r, max(COLOR.g, COLOR.b)) - lowest;\n\tfloat matte = smoothstep(0.80, 0.94, lowest) * (1.0 - smoothstep(0.05, 0.16, chroma));\n\tCOLOR.a *= smoothstep(0.0, max(fwidth(edge), 0.5), edge) * (1.0 - matte);\n}"

[sub_resource type="ShaderMaterial" id="plaque_clip_material"]
shader = SubResource("plaque_clip")

