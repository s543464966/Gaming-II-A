[sub_resource type="Shader" id="icon_mask"]
code = "shader_type canvas_item;\nvarying vec4 tint;\nvoid vertex() { tint = COLOR; }\nvoid fragment() { vec4 sample_color = texture(TEXTURE, UV); float luminance = dot(sample_color.rgb, vec3(0.299, 0.587, 0.114)); float coverage = sample_color.a * smoothstep(0.18, 0.55, luminance); COLOR = vec4(tint.rgb, tint.a * coverage); }"

[sub_resource type="ShaderMaterial" id="icon_mask_material"]
shader = SubResource("icon_mask")

[sub_resource type="Shader" id="diamond_clip"]
code = "shader_type canvas_item;\nuniform vec2 extent = vec2(111.0, 111.0);\nvarying vec2 local_uv;\nvoid vertex() { local_uv = VERTEX / extent; }\nvoid fragment() { float edge = abs(local_uv.x - 0.5) + abs(local_uv.y - 0.5); COLOR.a *= 1.0 - smoothstep(0.48, 0.50, edge); }"

[sub_resource type="ShaderMaterial" id="return_material"]
shader = SubResource("diamond_clip")

