[gd_scene load_steps=4 format=3]

[ext_resource type="PackedScene" path="res://ui/components/button.tscn" id="button"]
[ext_resource type="Shader" path="res://ui/design_system/themes/detail_supplement.gdshader" id="shader"]

[sub_resource type="ShaderMaterial" id="Material"]
shader = ExtResource("shader")

[node name="CategoryTrainingPanel" type="PanelContainer"]
layout_mode = 2
material = SubResource("Material")
theme_type_variation = &"DetailSupplement"

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Header" type="HBoxContainer" parent="Column"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Icon" type="TextureRect" parent="Column/Header"]
custom_minimum_size = Vector2(44, 44)
layout_mode = 2
mouse_filter = 2
self_modulate = Color(0.86, 0.78, 0.57, 1)
expand_mode = 1
stretch_mode = 5

[node name="Title" type="Label" parent="Column/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 26
vertical_alignment = 1
autowrap_mode = 3

[node name="Stars" type="Label" parent="Column/Header"]
layout_mode = 2
auto_translate_mode = 2
theme_override_font_sizes/font_size = 22
theme_override_colors/font_color = Color(0.86, 0.78, 0.57, 1)
vertical_alignment = 1

[node name="Strength" type="Label" parent="Column"]
layout_mode = 2
auto_translate_mode = 2
theme_override_font_sizes/font_size = 22
autowrap_mode = 3

[node name="Progress" type="ProgressBar" parent="Column"]
custom_minimum_size = Vector2(0, 10)
layout_mode = 2
theme_type_variation = &"DetailProgress"
show_percentage = false

[node name="Status" type="Label" parent="Column"]
layout_mode = 2
auto_translate_mode = 2
theme_override_font_sizes/font_size = 20
horizontal_alignment = 1
autowrap_mode = 3

[node name="Action" parent="Column" instance=ExtResource("button")]
layout_mode = 2
auto_translate_mode = 2
theme_type_variation = &"DetailActionButton"
compact = true
