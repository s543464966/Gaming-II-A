[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://features/collection/ui/active_hero_page.gd" id="script"]
[ext_resource type="Script" path="res://ui/components/touch_scroll_container.gd" id="scroll"]
[ext_resource type="PackedScene" path="res://ui/components/content/content_detail.tscn" id="detail"]
[ext_resource type="PackedScene" path="res://ui/components/button.tscn" id="button"]
[ext_resource type="Theme" path="res://ui/design_system/themes/game_theme.tres" id="theme"]

[node name="ActiveHeroPage" type="VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme = ExtResource("theme")
theme_override_constants/separation = 12
script = ExtResource("script")

[node name="Current" type="Label" parent="."]
layout_mode = 2
auto_translate_mode = 2
theme_override_font_sizes/font_size = 22
horizontal_alignment = 1
autowrap_mode = 3

[node name="Name" type="Label" parent="."]
layout_mode = 2
auto_translate_mode = 2
theme_override_font_sizes/font_size = 28
horizontal_alignment = 1

[node name="Paper" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(0, 240)
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"DetailPaper"

[node name="Scroll" type="ScrollContainer" parent="Paper"]
layout_mode = 2
horizontal_scroll_mode = 0
script = ExtResource("scroll")

[node name="Detail" parent="Paper/Scroll" instance=ExtResource("detail")]
layout_mode = 2

[node name="RosterTitle" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "ui.hero.owned"

[node name="Roster" type="ScrollContainer" parent="."]
custom_minimum_size = Vector2(0, 204)
layout_mode = 2
horizontal_scroll_mode = 1
vertical_scroll_mode = 0
script = ExtResource("scroll")

[node name="Cards" type="HBoxContainer" parent="Roster"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Confirm" parent="." instance=ExtResource("button")]
layout_mode = 2
theme_type_variation = &"DetailActionButton"
compact = true
text = "ui.hero.change"
